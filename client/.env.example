# ========================================================
# Sentinel Core Frontend (React + Vite) Environment Template
# ========================================================

# Backend API Base URL
# --------------------------------------------------------
# 1. Monolithic / Unified Deployment (Express serves client/dist):
#    Leave this empty. Requests will use relative '/api/...' paths on the same domain.
#
# 2. Decoupled Deployment (e.g. Vercel, Netlify, Cloudflare Pages):
#    Set this to your deployed backend origin WITHOUT trailing slash.
#    Example: https://sentinel-api.onrender.com or https://api.yourdomain.com
VITE_API_URL=
