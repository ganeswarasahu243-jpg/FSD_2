# ========================================================
# Sentinel Core Frontend (React + Vite) Environment Template
# ========================================================

# Backend API Base URL
# --------------------------------------------------------
# 1. Supabase Edge Functions:
#    Set this to your Supabase Functions gateway URL.
#    Example: https://<project-ref>.supabase.co/functions/v1/api
#    Or:      https://<project-ref>.supabase.co/functions/v1
#
# 2. Local Supabase CLI:
#    Example: http://127.0.0.1:54321/functions/v1/api
#
# 3. Decoupled Express / Render / Fly.io:
#    Example: https://sentinel-api.onrender.com
#
# 4. Monolithic / Unified Deployment (Express serves client/dist):
#    Leave this empty. Requests will use relative '/api/...' paths on the same domain.
VITE_API_URL=https://<your-project-ref>.supabase.co/functions/v1/api

# Supabase Public Anon Key (Required for Supabase gateway authorization)
# NEVER commit or expose the service_role secret key here!
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
