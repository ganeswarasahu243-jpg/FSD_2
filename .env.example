# ========================================================
# Sentinel Core Monorepo Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>.mongodb.net/sentinel_compliance?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.com
MEDIA_UPLOAD_DIR=server/uploads/policies

# Frontend Configuration (Used when building frontend)
# Leave blank if backend serves frontend on same domain
VITE_API_URL=
