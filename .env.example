# ========================================================
# Sentinel Core Monorepo Environment Configuration
# ========================================================

# Supabase Configuration (Edge Functions & PostgreSQL)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWKS_URL=https://<your-project-id>.supabase.co/auth/v1/.well-known/jwks.json

# Server Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<db_username>:<URL_ENCODED_PASSWORD>@<cluster-url>.mongodb.net/svp?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.com
MEDIA_UPLOAD_DIR=server/uploads/policies

# Frontend Configuration (Used when building client)
VITE_API_URL=https://<your-project-id>.supabase.co/functions/v1/api
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Demo Accounts Configuration (Interactive Testing & Demonstrations)
VITE_DEMO_EMPLOYEE_USERNAME=demo.employee
VITE_DEMO_EMPLOYEE_PASSWORD=demo1234
VITE_DEMO_ADMIN_USERNAME=demo.admin
VITE_DEMO_ADMIN_PASSWORD=adminDemo2026!
