# ========================================================
# Sentinel Core Backend Environment Template
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control!
# ========================================================

# Server Port (Render, Railway, Heroku set this automatically)
PORT=5000

# Application Environment ('development', 'production', 'test')
NODE_ENV=production

# --------------------------------------------------------
# Supabase Configuration (Edge Functions & PostgreSQL)
# --------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://<your-project-id>.supabase.co

# Supabase Public Anonymous Key (safe for browser and public Edge Function invocation)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Secret Key (Privileged backend key for admin migrations and functions)
# NEVER commit or expose to frontend client!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Supabase Auth JWKS Endpoint
SUPABASE_JWKS_URL=https://<your-project-id>.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Direct PostgreSQL Connection String (Pooler or Direct)
# Format: postgresql://postgres.<project-id>:<db_password>@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-id>:<db_password>@aws-0-region.pooler.supabase.com:6543/postgres

# --------------------------------------------------------
# MongoDB Connection (Retained for dual-stack verification)
# --------------------------------------------------------
# Local MongoDB: mongodb://127.0.0.1:27017/sentinel_compliance
# MongoDB Atlas (Cloud): mongodb+srv://<db_user>:<URL_ENCODED_PASSWORD>@<cluster-name>.mongodb.net/svp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<URL_ENCODED_PASSWORD>@<cluster-url>.mongodb.net/svp?retryWrites=true&w=majority

# --------------------------------------------------------
# JWT Authentication Secret Key
# --------------------------------------------------------
# Generate a secure 64-character secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters

# JWT Expiration Windows
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------------------
# Allowed Frontend Origins for CORS
# --------------------------------------------------------
CLIENT_URL=https://your-frontend-domain.com

# File Upload Storage Directory (Legacy local disk uploads)
MEDIA_UPLOAD_DIR=uploads/policies
