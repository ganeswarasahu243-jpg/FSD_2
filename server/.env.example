# ========================================================
# Sentinel Core Backend Environment Template
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control!
# ========================================================

# Server Port (Render, Railway, Heroku set this automatically)
PORT=5000

# Application Environment ('development', 'production', 'test')
NODE_ENV=production

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/sentinel_compliance
# MongoDB Atlas (Cloud): mongodb+srv://<db_user>:<URL_ENCODED_PASSWORD>@<cluster-name>.mongodb.net/svp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<URL_ENCODED_PASSWORD>@<cluster-url>.mongodb.net/svp?retryWrites=true&w=majority

# JWT Authentication Secret Key
# Generate a secure 64-character secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters

# JWT Expiration Windows
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS
# Single URL: https://sentinel-client.vercel.app
# Multiple URLs (comma-separated): https://sentinel.yourdomain.com,https://sentinel-preview.vercel.app
# Wildcard for development/monolithic: *
CLIENT_URL=https://your-frontend-domain.com

# File Upload Storage Directory (relative to server root or absolute path)
MEDIA_UPLOAD_DIR=uploads/policies
