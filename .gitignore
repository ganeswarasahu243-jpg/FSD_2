# ========================================================
# Git Ignore - Sentinel Core MERN Workspace
# ========================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
server/.env
client/.env

# Local Database Files
mongodb_data/
*.wt
*.lock

# Build Artefacts
dist/
client/dist/
build/

# Uploaded Files (Keep directory structure via .gitkeep)
server/uploads/policies/*
!server/uploads/policies/.gitkeep

# Legacy SQLite DB (if sensitive data present)
svp/uday/db.sqlite3

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
